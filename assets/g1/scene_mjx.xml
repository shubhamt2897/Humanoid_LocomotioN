<mujoco model="g1_29dof MJX training scene">
  <!-- MJX-compatible variant of scene_train.xml. Same robot (g1_29dof.xml, unmodified), but the
       ground is a PLANE rather than a heightfield.

       Why a separate scene instead of reusing scene_train.xml:
         MJX does not implement heightfield collision. scene_train.xml's floor is
         `type="hfield"` (the Perlin-noise terrain-DR curriculum in terrain.py writes into
         hfield_data at runtime), so it cannot be stepped by MJX at all.

       Consequence to be aware of: terrain domain randomization is NOT available on this backend.
       DomainRandCfg.terrain_enabled must stay False when running MJX. That is not a regression
       today -- terrain_enabled is already False and item 3 of PROGRESS.md's "Next phases" keeps
       terrain off until flat-ground walking works -- but re-enabling terrain later means either
       going back to the MuJoCo backend or expressing the terrain as something MJX supports.

       The robot's 25 MESH collision geoms are NOT edited here. They are disabled at load time by
       mjx_env.simplify_collisions(), which is both easier to keep in sync and easier to assert on
       than a duplicated geometry block. See that function for what it removes and why. -->

  <include file="g1_29dof.xml"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!-- friction matches scene_train.xml's floor so the two backends are comparable; per-env
         friction DR overwrites geom_friction[floor, 0] exactly as it does on the MuJoCo path. -->
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane" friction="0.8 0.02 0.001"/>
  </worldbody>
</mujoco>
